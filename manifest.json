{
  "manifest_version": 3,
  "name": "Mark as Watched for YouTube",
  "version": "1.1.1",
  "description": "Adds a \"Mark as watched\" option to YouTube video menus and under the player, recording the video as 100% watched in your history.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "scripts": ["src/background.js"]
  },
  "action": {
    "default_title": "Mark as Watched for YouTube",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["src/styles.css"],
      "run_at": "document_idle",
      "js": ["src/settings.js", "src/settings-bridge.js"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mark-as-watched@quangvu",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
